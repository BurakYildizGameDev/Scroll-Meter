    <!-- Onboarding & Permissions -->
    <string name="welcome_odyssey">Willkommen bei Odyssey ⚡</string>
    <string name="track_every_meter">Miss jeden Meter, den du scrollst.</string>
    <string name="onboarding_subtitle">Scroll-Meter misst die physische Distanz, die dein Finger auf Apps zurücklegt. Für Touch-Deltas wird die Barrierefreiheitsberechtigung benötigt.</string>
    <string name="trust_privacy_title">100% Datenschutzgarantie</string>
    <string name="trust_privacy_desc">canRetrieveWindowContent = false. Technisch unmöglich, Passwörter, Chats oder Bildschirminhalte zu lesen.</string>
    <string name="trust_network_title">Null Internet-Berechtigung</string>
    <string name="trust_network_desc">Keine Werbung, keine Tracker, kein Cloud-Upload. Alle Daten bleiben lokal in der Room-Datenbank.</string>
    <string name="trust_battery_title">Null Batterieverbrauch</string>
    <string name="trust_battery_desc">Sensor schläft bei ausgeschaltetem Bildschirm. 5s-Batching verbraucht &lt;0,5% CPU.</string>
