    <!-- Dual Engine Architecture -->
    <string name="mode_safe_title">Standard-Sicherheitsmodus (Empfohlen 🌟)</string>
    <string name="mode_safe_badge">100% SICHER &amp; KEINE WARNUNGEN</string>
    <string name="mode_safe_desc">Wandelt aktive Bildschirmzeit mithilfe des Android-Nutzungszugriffs und unserer Trittfrequenz-Engine in Distanz um. 0 eingeschränkte Einstellungen, 0 Akkuverbrauch.</string>
    <string name="mode_safe_btn">Nutzungszugriff aktivieren</string>
    <string name="mode_lab_title">Erweiterter Labormodus 🔬</string>
    <string name="mode_lab_badge">HARDWARE-PIXEL-DELTA</string>
    <string name="mode_lab_desc">Misst physisches Scrollen in Echtzeit auf Hardware-Ebene über den Barrierefreiheitsdienst.</string>
    <string name="mode_lab_btn">Barrierefreiheitsdienst aktivieren</string>
    <string name="mode_lab_warning_title">Android 13+ Hinweis zu eingeschränkten Einstellungen</string>
    <string name="mode_lab_warning_desc">Bei externen APKs schränkt Android Barrierefreiheit standardmäßig ein. Freischaltbar über App-Info > 3 Punkte > Eingeschränkte Einstellungen zulassen. Scroll-Meter hat keine Internetberechtigung.</string>
