    <!-- Doomscrolling & Digital Wellbeing Awareness -->
    <string name="wellbeing_title">无尽刷屏与虚假多巴胺陷阱</string>
    <string name="wellbeing_manifesto_badge">非游戏应用 • 觉察工具</string>
    <string name="wellbeing_manifesto_body">Scroll-Meter 绝不鼓励您多刷屏幕！其唯一使命是将无意识的强迫性刷屏转化为真实的物理距离，促使您放下手机。</string>
    <string name="wellbeing_fake_dopamine_title">老虎机多巴胺陷阱</string>
    <string name="wellbeing_fake_dopamine_desc">信息流算法利用“变额强化”机制。每一次滑动都会刺激大脑分泌微量虚假多巴胺，让大脑陷入无法满足的无底渴求中。</string>
    <string name="wellbeing_brain_fog_title">认知碎片化与脑雾</string>
    <string name="wellbeing_brain_fog_desc">高频快速切换内容会严重破坏深度思考能力，缩短注意力跨度，导致脑力衰竭。</string>
    <string name="wellbeing_thumb_strain_title">物理劳损与智能手机手综合征</string>
    <string name="wellbeing_thumb_strain_desc">重复性微滑动易引发拇指狭窄性腱鞘炎以及颈椎过度前倾压力（短信脖）。</string>
    <string name="wellbeing_tip_take_break">建议：达到每日限制后，将手机屏幕朝下静置20分钟。</string>

