    <!-- Onboarding & Permissions -->
    <string name="welcome_odyssey">Benvenuto in Odyssey ⚡</string>
    <string name="track_every_meter">Misura ogni metro che scorri.</string>
    <string name="onboarding_subtitle">Scroll-Meter misura la distanza fisica percorsa dal tuo pollice nelle app. Per rilevare il tocco, Android richiede il permesso di accessibilità.</string>
    <string name="trust_privacy_title">100% Garanzia di Privacy</string>
    <string name="trust_privacy_desc">canRetrieveWindowContent = false. Impossibile leggere password, chat o schermate.</string>
    <string name="trust_network_title">Zero permessi Internet</string>
    <string name="trust_network_desc">Nessuna pubblicità, nessun tracciamento né upload su cloud. Tutto resta nel database locale Room.</string>
    <string name="trust_battery_title">Zero consumo batteria</string>
    <string name="trust_battery_desc">Il sensore va in standby a schermo spento. Il batching a 5s usa &lt;0,5% di CPU.</string>
