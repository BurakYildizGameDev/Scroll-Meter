    <!-- Dual Engine Architecture -->
    <string name="mode_safe_title">Standart Güvenli Mod (Önerilen 🌟)</string>
    <string name="mode_safe_badge">100% GÜVENLİ &amp; SIFIR UYARI</string>
    <string name="mode_safe_desc">Android Kullanım Erişimi (UsageStats) ve akıllı Doomscroll Kadans Motoru ile ekran süresini gerçek mesafeye dönüştürür. Sıfır kısıtlı ayar, sıfır uyarı ve %0 pil tüketimi.</string>
