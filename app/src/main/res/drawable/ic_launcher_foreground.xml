<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Telemetry Ring Track -->
    <path
        android:pathData="M 33,68 A 25,25 0 1,1 75,68"
        android:strokeWidth="3.2"
        android:strokeColor="#26FFFFFF"
        android:strokeLineCap="round" />

    <!-- Active Neon Gradient Dial Arc -->
    <path
        android:pathData="M 33,68 A 25,25 0 1,1 66,32"
        android:strokeWidth="3.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="33"
                android:startY="68"
                android:endX="66"
                android:endY="32"
                android:type="linear">
                <item android:color="#00E676" android:offset="0.0" />
                <item android:color="#00F0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Phone Display Outline -->
    <path
        android:pathData="M 45,36 L 63,36 A 4,4 0 0,1 67,40 L 67,68 A 4,4 0 0,1 63,72 L 45,72 A 4,4 0 0,1 41,40 L 41,40 A 4,4 0 0,1 45,36 Z"
        android:strokeWidth="2.0"
        android:strokeColor="#4000F0FF"
        android:fillColor="#1500F0FF" />

    <!-- Kinetic Vertical Scroll Flow Arrow (Upwards Motion) -->
    <path
        android:pathData="M 54,64 L 54,44 M 48,50 L 54,44 L 60,50"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="64"
                android:endX="54"
                android:endY="44"
                android:type="linear">
                <item android:color="#00E676" android:offset="0.0" />
                <item android:color="#00F0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ruler Metric Precision Ticks on Phone Side -->
    <path
        android:pathData="M 67,44 L 71,44 M 67,50 L 73,50 M 67,56 L 71,56 M 67,62 L 74,62"
        android:strokeWidth="1.6"
        android:strokeColor="#00E676"
        android:strokeLineCap="round" />

    <!-- Core Telemetry Pulse Dot -->
    <path
        android:pathData="M 54,39 A 1.2,1.2 0 1,1 54,39.01"
        android:strokeWidth="2.4"
        android:strokeColor="#00F0FF"
        android:strokeLineCap="round" />

</vector>
