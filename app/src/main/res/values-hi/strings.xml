    <!-- Onboarding & Permissions -->
    <string name="welcome_odyssey">ओडिसी में आपका स्वागत है ⚡</string>
    <string name="track_every_meter">अपने स्क्रॉल किए गए हर मीटर को ट्रैक करें।</string>
    <string name="onboarding_subtitle">Scroll-Meter मापता है कि आपकी उंगली ऐप्स में कितनी भौतिक दूरी तय करती है। टच स्क्रॉल को पहचानने के लिए Android को एक्सेसिबिलिटी सर्विस अनुमति की आवश्यकता होती है।</string>
    <string name="trust_privacy_title">100% गोपनीयता गारंटी</string>
    <string name="trust_privacy_desc">canRetrieveWindowContent = false. पासवर्ड, चैट या स्क्रीन टेक्स्ट को पढ़ना तकनीकी रूप से असंभव है।</string>
    <string name="trust_network_title">शून्य इंटरनेट अनुमति</string>
    <string name="trust_network_desc">कोई विज्ञापन नहीं, कोई ट्रैकर नहीं, कोई क्लाउड अपलोड नहीं। सारा डेटा आपके स्थानीय Room SQLite डेटाबेस में रहता है।</string>
    <string name="trust_battery_title">शून्य बैटरी खपत</string>
    <string name="trust_battery_desc">स्क्रीन बंद होने पर सेंसर अपने आप सो जाता है। 5 सेकंड बैचिंग बफर &lt;0.5% CPU उपयोग करता है।</string>
    <string name="btn_continue">जारी रखें</string>
    <string name="btn_activate_service">सेवा सक्रिय करें ⚡</string>
