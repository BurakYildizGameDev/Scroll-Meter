    <string name="app_name">Scroll-Meter</string>
    <string name="accessibility_service_description">Scroll-Meter आपकी स्क्रीन स्क्रॉल दूरी को पिक्सेल सटीकता के साथ मापता है। आपके पासवर्ड, संदेश या स्क्रीन सामग्री को तकनीकी रूप से कभी नहीं पढ़ा जा सकता।</string>
    <string name="notification_channel_name">Scroll-Meter ट्रैकिंग सेवा</string>
    <string name="notification_channel_desc">पृष्ठभूमि में चुपचाप स्क्रॉल दूरी को ट्रैक करता है।</string>

