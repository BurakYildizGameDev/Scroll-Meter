    <string name="ach_first_step_title">पहला कदम</string>
    <string name="ach_first_step_desc">किसी भी ऐप में अपने पहले 100 मीटर स्क्रॉल करें।</string>
    <string name="ach_giraffe_title">जिराफ क्लब</string>
    <string name="ach_giraffe_desc">धरती के सबसे ऊंचे जानवर (5.5 मी) की ऊंचाई को पार करें।</string>
    <string name="ach_liberty_title">स्टैच्यू ऑफ लिबर्टी</string>
    <string name="ach_liberty_desc">स्टैच्यू ऑफ लिबर्टी की कुरसी की ऊंचाई (93 मी) पार करें।</string>
    <string name="ach_eiffel_title">एफिल पर्वतारोही</string>
    <string name="ach_eiffel_desc">एक ही दिन में एफिल टॉवर (330 मी) की ऊंचाई तक स्क्रॉल करें।</string>
    <string name="ach_burj_title">बुर्ज खलीफा</string>
    <string name="ach_burj_desc">बुर्ज खलीफा के अवलोकन डेक (828 मी) तक पहुंचें।</string>
    <string name="ach_marathon_title">अंगूठा मैराथन</string>
    <string name="ach_marathon_desc">एक सक्रिय दिन में 1,000 मीटर स्क्रॉल करें।</string>
    <string name="ach_speed_title">गति का जादूगर</string>
    <string name="ach_speed_desc">किसी एक प्रमुख ऐप में 250 मीटर से अधिक स्क्रॉल करें।</string>
    <string name="ach_social_title">सोशल एक्सप्लोरर</string>
    <string name="ach_social_desc">कम से कम 3 अलग-अलग ऐप्स में सक्रिय स्क्रॉलिंग सत्र दर्ज करें।</string>
    <string name="ach_precision_title">सटीक ट्यूनर</string>
    <string name="ach_precision_desc">ऑन-स्क्रीन रूलर का उपयोग करके स्क्रीन के भौतिक पैमाने को कैलिब्रेट करें।</string>

    <!-- Settings & Calibration -->
    <string name="screen_calibration">स्क्रीन कैलिब्रेशन</string>
    <string name="screen_calibration_desc">अपने फोन की स्क्रीन पर एक असली भौतिक रूलर रखें। स्लाइडर को तब तक समायोजित करें जब तक कि वर्चुअल मिलीमीटर के निशान आपके रूलर से पूरी तरह मेल न खा जाएं।</string>
    <string name="calibration_multiplier">गुणक: %1$.2fx (%2$s)</string>
