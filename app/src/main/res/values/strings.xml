    <string name="demo_mode_desc">Instantly load mock telemetry, unlocked achievements, and weekly charts for evaluation.</string>

    <!-- Dual Engine Architecture -->
    <string name="mode_safe_title">Standard Safe Mode (Recommended 🌟)</string>
    <string name="mode_safe_badge">100% SAFE &amp; ZERO WARNINGS</string>
    <string name="mode_safe_desc">Converts active screen time to physical scroll distance using Android Usage Access and our smart Cadence Engine. Zero restricted settings, zero battery drain.</string>
    <string name="mode_safe_btn">Enable Usage Access</string>
    <string name="mode_lab_title">Advanced Lab Mode 🔬</string>
    <string name="mode_lab_badge">HARDWARE PIXEL DELTA</string>
    <string name="mode_lab_desc">Measures physical pixel scrolling in real-time at the hardware level using Android Accessibility Service.</string>
    <string name="mode_lab_btn">Enable Accessibility Service</string>
    <string name="mode_lab_warning_title">Android 13+ Restricted Settings Note</string>
    <string name="mode_lab_warning_desc">For sideloaded APKs, Android restricts Accessibility by default. Enable via App Info > 3 dots > Allow restricted settings. Scroll-Meter has zero internet permissions; your data never leaves your device.</string>
