    <string name="welcome_odyssey">Welcome to Odyssey ⚡</string>
    <string name="track_every_meter">Track Every Meter You Scroll.</string>
    <string name="onboarding_subtitle">Scroll-Meter measures the physical distance your finger travels across apps. To detect touch scroll deltas, Android requires the Accessibility Service permission.</string>
    <string name="trust_privacy_title">100% Privacy Guarantee</string>
    <string name="trust_privacy_desc">canRetrieveWindowContent = false. Technically impossible to read passwords, chats, or screen text.</string>
    <string name="trust_network_title">Zero Internet Permission</string>
    <string name="trust_network_desc">No ads, no trackers, no cloud upload. All telemetry stays in your local Room SQLite database.</string>
    <string name="trust_battery_title">Zero Battery Drain</string>
    <string name="trust_battery_desc">Screen-off sensor sleeps automatically. High-capacity buffer with 5s batching uses &lt;0.5% CPU.</string>
